{
  "name": "bugshot",
  "version": "1.0.0",
  "description": "Universal UI feedback tool — screenshot, annotate, send to AI via MCP",
  "author": "DreamNight",
  "license": "MIT",
  "homepage": "https://github.com/dreamnight16/anime-con-radar",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamnight16/anime-con-radar"
  },
  "bugs": {
    "url": "https://github.com/dreamnight16/anime-con-radar/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ electron/",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && electron-builder --win --mac --linux --publish always",
    "release:dry": "npm run build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.0",
    "i18next": "^24.2.0",
    "lucide-react": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.0",
    "happy-dom": "^16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^2.1.0"
  }
}
